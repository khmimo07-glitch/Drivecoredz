<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<title>DriveCoreDZ MARKET</title>

<style>
body{margin:0;font-family:Arial;background:#0f172a;color:white;text-align:center;}
header{background:#0b1220;padding:15px;border-bottom:2px solid #38bdf8;}
.logo{color:#38bdf8;font-size:24px;font-weight:bold;}
.section{background:#1e293b;width:92%;margin:10px auto;padding:12px;border-radius:12px;}
input,button{width:92%;padding:10px;margin-top:8px;border:none;border-radius:8px;}
button{background:#22c55e;color:white;cursor:pointer;}
.card{background:#111827;padding:10px;margin-top:8px;border-radius:10px;text-align:right;border:1px solid #334155;}
</style>
</head>

<body>

<header>
<div class="logo">⚡ DriveCoreDZ MARKET</div>
<button onclick="login()">🔐 تسجيل الدخول</button>
</header>

<div class="section">
<h3>➕ إضافة قطعة</h3>
<input id="name" placeholder="اسم القطعة">
<input id="price" placeholder="السعر">
<input id="shop" placeholder="المحل">
<input id="car" placeholder="السيارة">
<button onclick="addProduct()">إضافة</button>
</div>

<div class="section">
<button onclick="loadProducts()">📦 عرض المنتجات</button>
<button onclick="loadOrders()">📋 الطلبات</button>
</div>

<div id="result" class="section">النتائج تظهر هنا...</div>

<script type="module">

// Firebase SDK
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";
import { getAuth, GoogleAuthProvider, signInWithPopup } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";


// 🔥 Firebase config (جاهز)
const firebaseConfig = {
  apiKey: "AIzaSyCf33AKSYpmteKqKDYKVO_aUQoHumpAyzc",
  authDomain: "drivecoredz.firebaseapp.com",
  projectId: "drivecoredz",
  storageBucket: "drivecoredz.firebasestorage.app",
  messagingSenderId: "1094834321130",
  appId: "1:1094834321130:web:66d6af4797ea62dc7f0993"
};


// Init
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
const auth = getAuth(app);


// ================= LOGIN =================
window.login = async function(){
const provider = new GoogleAuthProvider();
const res = await signInWithPopup(auth, provider);
alert("مرحبا " + res.user.displayName);
};


// ================= ADD PRODUCT =================
window.addProduct = async function(){

await addDoc(collection(db,"products"),{
name:name.value,
price:price.value,
shop:shop.value,
car:car.value,
time:new Date()
});

alert("تمت الإضافة 🚀");

name.value="";
price.value="";
shop.value="";
car.value="";
};


// ================= LOAD PRODUCTS =================
window.loadProducts = async function(){

let data = await getDocs(collection(db,"products"));

let r="";

data.forEach(d=>{
let p=d.data();

r += `
<div class="card">
🧠 ${p.name}<br>
💰 ${p.price}<br>
🏪 ${p.shop}<br>
🚗 ${p.car}
</div>
`;
});

result.innerHTML = r;
};


// ================= LOAD ORDERS =================
window.loadOrders = async function(){

let data = await getDocs(collection(db,"orders"));

let r="📦 الطلبات:<br><br>";

data.forEach(d=>{
let o=d.data();

r += `
<div class="card">
🛒 ${o.productName || "طلب"}<br>
👤 ${o.userName || "User"}<br>
</div>
`;
});

result.innerHTML = r;
};

</script>

</body>
</html>
