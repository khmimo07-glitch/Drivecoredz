<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DriveCoreDZ</title>

<style>

body{
margin:0;
font-family:Arial;
background:#0f172a;
color:white;
text-align:center;
}

header{
background:#0b1220;
padding:18px;
border-bottom:2px solid #38bdf8;
}

.logo{
font-size:28px;
font-weight:bold;
color:#38bdf8;
}

.section{
background:#1e293b;
width:92%;
margin:12px auto;
padding:15px;
border-radius:14px;
}

input,select,button{
width:92%;
padding:12px;
margin-top:8px;
border:none;
border-radius:10px;
font-size:15px;
}

button{
background:#22c55e;
color:white;
font-weight:bold;
cursor:pointer;
}

button:hover{
opacity:0.9;
}

.card{
background:#111827;
padding:12px;
margin-top:10px;
border-radius:12px;
text-align:right;
border:1px solid #334155;
}

.small{
font-size:13px;
color:#94a3b8;
}

</style>
</head>

<body>

<header>
<div class="logo">⚡ DriveCoreDZ</div>
<div class="small">
Marketplace Automobile Algérien
</div>
</header>

<!-- REGISTER -->
<div class="section">

<h3>👤 الحساب</h3>

<input id="email" placeholder="Email">

<input id="password" type="password" placeholder="Password">

<select id="role">
<option value="client">🚗 زبون</option>
<option value="shop">🏪 محل</option>
</select>

<button onclick="register()">
إنشاء حساب
</button>

<button onclick="login()">
تسجيل الدخول
</button>

</div>

<!-- ADD PRODUCT -->
<div class="section">

<h3>➕ إضافة قطعة</h3>

<input id="productName" placeholder="اسم القطعة">

<input id="productPrice" placeholder="السعر">

<input id="productCar" placeholder="السيارة">

<button onclick="addProduct()">
إضافة قطعة
</button>

</div>

<!-- PRODUCTS -->
<div class="section">

<h3>📦 المنتجات</h3>

<button onclick="loadProducts()">
عرض المنتجات
</button>

</div>

<!-- ORDERS -->
<div class="section">

<h3>🛒 الطلبات</h3>

<button onclick="loadOrders()">
عرض الطلبات
</button>

</div>

<div id="result" class="section">
النتائج تظهر هنا...
</div>

<script type="module">

// ================= FIREBASE =================

import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";

import {
getFirestore,
collection,
addDoc,
getDocs
}
from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

import {
getAuth,
createUserWithEmailAndPassword,
signInWithEmailAndPassword
}
from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";


// ================= CONFIG =================

const firebaseConfig = {

apiKey: "AIzaSyCf33AKSYpmteKqKDYKVO_aUQoHumpAyzc",

authDomain: "drivecoredz.firebaseapp.com",

projectId: "drivecoredz",

storageBucket: "drivecoredz.firebasestorage.app",

messagingSenderId: "1094834321130",

appId: "1:1094834321130:web:66d6af4797ea62dc7f0993"

};


// ================= INIT =================

const app = initializeApp(firebaseConfig);

const db = getFirestore(app);

const auth = getAuth(app);


// ================= REGISTER =================

window.register = async function(){

try{

await createUserWithEmailAndPassword(
auth,
email.value,
password.value
);

await addDoc(collection(db,"users"),{

email:email.value,
role:role.value,
createdAt:new Date()

});

alert("تم إنشاء الحساب 🚀");

}catch(e){

alert(e.message);

}

}


// ================= LOGIN =================

window.login = async function(){

try{

await signInWithEmailAndPassword(
auth,
email.value,
password.value
);

alert("تم تسجيل الدخول 🚀");

}catch(e){

alert(e.message);

}

}


// ================= ADD PRODUCT =================

window.addProduct = async function(){

try{

await addDoc(collection(db,"products"),{

name:productName.value,
price:productPrice.value,
car:productCar.value,
createdAt:new Date()

});

alert("تمت إضافة القطعة 🚀");

}catch(e){

alert(e.message);

}

}


// ================= LOAD PRODUCTS =================

window.loadProducts = async function(){

let data = await getDocs(collection(db,"products"));

let r = "";

data.forEach(d=>{

let p = d.data();

r += `

<div class="card">

🔧 ${p.name}<br>

💰 ${p.price} DA<br>

🚗 ${p.car}<br><br>

<button onclick="orderProduct('${p.name}','${p.price}')">
🛒 طلب
</button>

</div>

`;

});

result.innerHTML = r;

}


// ================= ORDER =================

window.orderProduct = async function(name,price){

try{

await addDoc(collection(db,"orders"),{

product:name,
price:price,
status:"pending",
createdAt:new Date()

});

alert("تم إرسال الطلب 🚀");

}catch(e){

alert(e.message);

}

}


// ================= LOAD ORDERS =================

window.loadOrders = async function(){

let data = await getDocs(collection(db,"orders"));

let r = "";

data.forEach(d=>{

let o = d.data();

r += `

<div class="card">

🛒 ${o.product}<br>

💰 ${o.price} DA<br>

📦 ${o.status}

</div>

`;

});

result.innerHTML = r;

}

</script>

</body>
</html>
